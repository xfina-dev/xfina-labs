{
  "name": "xfina-labs",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "npm run build:wasm && vite",
    "build": "npm run build:wasm && vite build",
    "preview": "vite preview",
    "build:wasm": "node scripts/engine-deps.mjs && wasm-pack build engine --release --target web --out-dir ../src/portfolio-engine/engine-pkg --out-name engine",
    "engine:deps": "node scripts/engine-deps.mjs",
    "test:engine": "cargo test --manifest-path engine/Cargo.toml",
    "build:tree": "node scripts/build-tree.mjs"
  },
  "dependencies": {
    "lucide-vue-next": "^1.0.0",
    "vue": "^3.5.34",
    "xfina-ui": "0.9.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.6",
    "autoprefixer": "^10.5.0",
    "postcss": "^8.5.15",
    "tailwindcss": "^3.4.19",
    "vite": "^8.0.12",
    "wrangler": "^4.125.0"
  }
}
